{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/logifit-platform-admin/browser",
  "installCommand": "npm install",
  "framework": "angular",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://logicfit-saas-model.runasp.net/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://logicfit-saas-model.runasp.net/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
